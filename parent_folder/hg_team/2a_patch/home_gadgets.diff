+/* ---------------------------------------------------------------- clap control (experimental) */
+
+// true if an effect is sound reactive: 'v' (volume) or 'f' (frequency) in the flags of its metadata
+// "Name@sliders;colors;palette;flags;defaults" (FX.cpp); the flags are the 4th field, after the 3rd ';'
+static bool hgIsSoundEffect(uint8_t mode) {
+  const char *p = strip.getModeData(mode);  // PROGMEM
+  unsigned field = 0;
+  for (char ch = static_cast<char>(pgm_read_byte(p)); ch != '\0'; ch = static_cast<char>(pgm_read_byte(++p))) {
+    if (ch == ';') {
+      if (++field > 3) break;  // past the flags
+    } else if (field == 3 && (ch == 'v' || ch == 'f')) {
+      return true;
+    }
+  }
+  return false;
+}
