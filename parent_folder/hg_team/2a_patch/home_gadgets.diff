+// Counts claps (rising edges of audioreactive's samplePeak) and runs the 2-clap or 3-clap actions.
+// samplePeak stays true for more than max(50 ms, frame time) (autoResetPeak() in audioreactive), so passes that
+// come at least that often see every peak. After a slower pass a clap may have been missed: a sequence that
+// contains such a pass is ignored instead of being counted wrong (3 claps must never run the 2-clap actions).
+void HomeGadgets::handleClap(uint32_t now) {
+  const uint16_t frameTime = strip.getFrameTime();
+  const uint32_t peakHold = frameTime > HG_CLAP_PEAK_HOLD_MS ? frameTime : HG_CLAP_PEAK_HOLD_MS;
+  const bool late = now - clapPollAt > peakHold;
+  clapPollAt = now;
+  if (late) clapBlindAt = now;
+  if (clapCooling && now - clapFiredAt >= HG_CLAP_COOLDOWN_MS) clapCooling = false;
+
+  um_data_t *um = nullptr;
+  const bool audio = clap.en && micOn && UsermodManager::getUMData(&um, USERMOD_ID_AUDIOREACTIVE) &&
+                     um && um->u_data && um->u_size > 3 && um->u_data[0] && um->u_data[3];
+  clapReady = audio && !clapSoundFx();
+  if (!clapReady) {
+    // off or suppressed: drop the sequence; afterwards a clap needs a new edge and a second of recorded quiet
+    clapCount = 0;
+    clapPeakPrev = true;
+    memset(clapVolHist, 0xFF, sizeof(clapVolHist));
+    return;
+  }
+
+  if (late && clapCount) clapCount = HG_CLAP_BAD;  // a clap of this sequence may have been missed
+
+  // evaluate the sequence one second after its last clap
+  if (clapCount && now - clapLastAt >= HG_CLAP_EVAL_MS) {
+    const uint8_t n = clapCount;
+    clapCount = 0;
+    if (n == 2 || n == 3) {
+      DEBUG_PRINTF_P(PSTR("HomeGadgets: %u claps\n"), (unsigned)n);
+      clapCooling = true;
+      clapFiredAt = now;
+      curSrc = SRC_CLAP;
+      runActions(n == 2 ? clap.a2 : clap.a3);
+    }
+  }
+
+  const bool peak = *static_cast<const bool*>(um->u_data[3]);  // set by the audioreactive FFT task and loop()
+  const bool edge = peak && !clapPeakPrev;
+  clapPeakPrev = peak;
+  if (edge && !clapCooling) {
