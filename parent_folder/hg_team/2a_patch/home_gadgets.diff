+    clapVolPos = (clapVolPos + 1) % HG_CLAP_VOL_SLOTS;
+    clapVolHist[clapVolPos] = 0;
+  }
+  if (vol > clapVolHist[clapVolPos]) clapVolHist[clapVolPos] = vol;
+}
