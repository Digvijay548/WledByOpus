+// true while LED 1 or LED 2 shows a sound reactive effect (music is probably playing);
+// the metadata is only parsed when the effect of a strip changes
+bool HomeGadgets::clapSoundFx() {
+  if (bri == 0) return false;  // WLED is off, nothing is shown
+  for (unsigned k = 0; k < HG_STRIPS; k++) {
+    if (stripSeg[k] >= strip.getSegmentsNum()) continue;
+    const Segment &seg = strip.getSegment(stripSeg[k]);
+    if (!seg.isActive() || !seg.on) continue;
+    if (seg.mode != clapFxMode[k]) {
+      clapFxMode[k]  = seg.mode;
+      clapFxSound[k] = hgIsSoundEffect(seg.mode);
+    }
+    if (clapFxSound[k]) return true;
+  }
+  return false;
+}
