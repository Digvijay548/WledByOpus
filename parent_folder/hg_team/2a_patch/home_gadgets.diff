+/* ---------------------------------------------------------------- schedules, away */
+
+// true if minute of day m lies in [from, to); from > to wraps past midnight, from == to is an empty window
+static bool hgInWindow(unsigned m, unsigned from, unsigned to) {
+  return (from <= to) ? (m >= from && m < to) : (m >= from || m < to);
+}
+
+// clock based automations, called from loop() right after handleTimers()
+void HomeGadgets::handleClock(uint32_t now) {
+  if (now - clockCheckAt >= HG_CLOCK_CHECK_MS) {
+    clockCheckAt = now;
+    if (!hgTimeValid()) {
+      clockMin = 0;  // once the clock is back, start again at the current minute: past schedules never run
+    } else {
+      // WLED refreshes localTime once per second; a time sync in this loop (e.g. UDP) may not be in it yet
+      updateLocalTime();
+      const uint32_t m = (uint32_t)(localTime / 60);  // local minutes since 1970
+      if (m != clockMin) {
+        // after a stalled loop the skipped minutes run late (up to HG_SCH_CATCHUP_MIN); after a clock
+        // jump (first sync, resync, DST) only the current minute runs, firedDay prevents double runs
+        uint32_t k = (clockMin && m > clockMin && m - clockMin <= HG_SCH_CATCHUP_MIN + 1U) ? clockMin + 1 : m;
+        clockMin = m;
+        for (; k <= m; k++) checkSchedules(k);
+      }
+    }
+  }
+  handleAway(now);  // every loop, so switching away mode off takes effect at once
+}
+
+// runs the schedules that are due in the given local minute (minutes since 1970)
+void HomeGadgets::checkSchedules(uint32_t localMin) {
+  const time_t t = (time_t)localMin * 60;
+  const uint16_t today = localMin / HG_MIN_PER_DAY;       // local day number, as TimeLib's elapsedDays()
+  const int nowMin = hour(t) * 60 + minute(t);
+  const unsigned dayBit = 1U << ((weekday(t) + 5) % 7);   // TimeLib weekday(): 1 = Sunday; bit 0 = Monday here
+  // local times of today's sunrise / sunset, 0 when no location is set (see hgIsDayTime())
+  const int riseMin = sunrise ? hour(sunrise) * 60 + minute(sunrise) : -1;
+  const int setMin  = sunset  ? hour(sunset)  * 60 + minute(sunset)  : -1;
+  for (unsigned i = 0; i < HG_SCHEDULES; i++) {
+    HgSchedule &s = schedules[i];
+    if (!s.en || !(s.days & dayBit) || s.firedDay == today) continue;
+    int due = s.atMin;
+    if (s.type != SCH_CLOCK) {
+      const int base = (s.type == SCH_SUNRISE) ? riseMin : setMin;
+      if (base < 0) continue;
+      due = constrain(base + s.atMin, 0, HG_MIN_PER_DAY - 1);
+    }
+    if (due != nowMin) continue;
+    s.firedDay = today;
+    DEBUG_PRINTF_P(PSTR("HomeGadgets: schedule %u\n"), i + 1);
+    curSrc = SRC_SCHEDULE;
+    runActions(s.actions);
+  }
+}
+
+// presence simulation: while the window is open, the selected relays are switched at random intervals.
+// When the window closes or the clock is lost, the simulated relays go off, and strips that got the away
+// mood at the start are switched off as well. When away mode is switched off (from any path) inside the
+// window, everything stays as it is: someone probably came home and should not be left in the dark.
+void HomeGadgets::handleAway(uint32_t now) {
+  const bool active = away.en && clockMin && hgInWindow(clockMin % HG_MIN_PER_DAY, away.from, away.to);
+  if (active != awayActive) {
+    awayActive = active;
+    if (active) {
+      awayMoodMask = 0;
+      if (away.mood >= 0) {
+        applyMood((uint8_t)away.mood, away.ms);
+        awayMoodMask = away.ms;
+      }
+    } else {
+      if (away.en) {
+        for (unsigned i = 0; i < HG_RELAYS; i++) if (awayRelMask & (1U << i)) autoRelayOff(i, SRC_AWAY);
+        if (awayMoodMask) setStrips(awayMoodMask, false);
+      }
+      awayRelMask = 0;
+      awayMoodMask = 0;
+    }
+    DEBUG_PRINTF_P(PSTR("HomeGadgets: away %s\n"), active ? "on" : "off");
+    notifyUi();
+  }
+  if (!awayActive) return;
+
+  // "stays on" relays are left out: automations can switch them on but never off again
+  uint8_t rel = away.rel;
+  for (unsigned i = 0; i < HG_RELAYS; i++) if (relays[i].keep) rel &= ~(1U << i);
+  auto gapMs = [this]() -> uint32_t {  // random pause between gapMin and gapMax minutes
+    return away.gapMin * 60000UL + esp_random() % ((away.gapMax - away.gapMin) * 60000UL + 1);
+  };
+  for (unsigned i = 0; i < HG_RELAYS; i++) {
+    const uint8_t bit = 1U << i;
+    if ((rel & bit) && !(awayRelMask & bit)) {         // window opened or relay selected: first toggle after a pause
+      awayRelMask |= bit;
+      awayNextAt[i] = now + gapMs();
+    } else if (!(rel & bit) && (awayRelMask & bit)) {  // relay deselected while the window is open
+      awayRelMask &= ~bit;
+      autoRelayOff(i, SRC_AWAY);
+    } else if ((awayRelMask & bit) && (int32_t)(now - awayNextAt[i]) >= 0) {
+      if (relays[i].state) autoRelayOff(i, SRC_AWAY);
+      else setRelay(i, true, SRC_AWAY);
+      awayNextAt[i] = now + gapMs();
+    }
+  }
+}
+
+// away mode on/off from the page or the JSON API (CMD_AWAY); handleAway() starts or ends the simulation
+void HomeGadgets::setAway(bool on) {
+  if (away.en != on) {
+    away.en = on;
+    markConfigDirty();  // /home.json is written by handleTimers() a few seconds later
+  }
+  notifyUi();
+}
