+      }
+    } else if (now - clapLastAt >= HG_CLAP_MIN_GAP_MS) {  // a closer peak is the echo of the last clap
+      if (now - clapLastAt > HG_CLAP_MAX_GAP_MS || clapCount >= HG_CLAP_MAX_COUNT) clapCount = HG_CLAP_BAD;  // too slow or too many
