+// animated previews: 6c's effect engine FXS from /home/fx.js, then the /json/palx pages and the built-in mood looks /home/bm, one
+// request at a time. Older firmware has none of these: fxS stays null and the page shows no previews. Without a settings PIN
+// the script is not loaded at all: it may be a file anyone could have uploaded (X22)
+let fxS=null, fxsP=null, fxBm=null, fxPvs=[];
+function fxEngine(){
+	return fxsP||(fxsP=(cfg.pinSet===false?Promise.reject():loadFx()).then(()=>new Promise(r=>d.head.append(h("script",{src:"/home/fx.js",onload:()=>r(window.FXS),onerror:()=>r()})))).then(async F=>{
+		if(!F||!F.preview) return;
+		for(let p=0,m=0,t=0;p<=m;) try{ const j=await getJSON("/json/palx?page="+p); m=j.m; F.setPalettes(j.p); p++; }catch(e){ if(++t>4) break; await sleep(300*t); }
+		try{ fxBm=await getJSON("/home/bm"); }catch(e){}
+		return fxS=F;
+	},()=>{ fxsP=null; })); // no PIN, or the effect list did not load (device busy): ask again next time
+}
+// the effect's default sliders and palette ("sx=24,pal=50" in its metadata), as Segment::setMode(fx,true) loads them
+function fxDef(i){
+	const o={fx:fxc.eff[i]};
+	for(const s of ((fxc.fxd[i]||"").split(";")[4]||"").split(",")){ const [k,v]=s.split("="); if(v) o[k]=+v; }
+	if(o.pal>0) o.dpal=o.pal; // what "Default" shows for this effect
+	return o;
+}
+// FXS options for a mood look (a cfg.moods item, or a built-in's /home/bm entry plus its fx); pal "" = the effect's default
+function moodFx(L){
+	if(!L||L.sx==null) return null;
+	let fx=fxc.eff.indexOf(L.fx); if(fx<0) fx=L.fxid|0;
+	const o=fxDef(fx), p=fxc.pal.indexOf(L.pal);
+	return Object.assign(o,L,{fx:o.fx,pal:p>=0?p:L.palid!=null?L.palid:o.pal|0,len:30});
+}
+// preview on canvas c with options of(); fxSweep() stops those whose canvas left the page, fxSweep(1) also refreshes the others
+function fxPv(c,of){ fxPvs.push([c,fxS.preview(c,of()),of]); return c; }
+function fxSweep(upd){ fxPvs=fxPvs.filter(([c,p,of])=>c.isConnected?(upd&&p.set(of()),1):p.stop()); }
 
