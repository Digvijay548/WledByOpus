+#ifndef WLED_DISABLE_WEBSOCKETS
+// runs in the web task. A preview client needs the API key (/home/ws?k=KEY): browsers let any web site open a
+// websocket to any host, and the LED colors show when someone is at home. At most HG_WS_CLIENTS are accepted.
+void HomeGadgets::onWsEvent(AsyncWebSocketClient *client, AwsEventType type, void *arg) {
+  if (type == WS_EVT_CONNECT) {
+    AsyncWebServerRequest *request = static_cast<AsyncWebServerRequest*>(arg);  // the upgrade request (AsyncWebSocket.cpp)
+    const AsyncWebParameter *keyParam = request ? request->getParam(F("k")) : nullptr;
+    int slot = -1;
+    if (enabled && keyParam && keyOk(keyParam->value().c_str())) {  // keyOk() also rejects while no key exists yet
+      for (unsigned i = 0; i < HG_WS_CLIENTS; i++) if (!hgWsIds[i]) { slot = i; break; }
+    }
+    if (slot < 0) {
+      client->close();
+      return;
+    }
+    hgWsIds[slot] = client->id();  // ids start at 1
+    wsHash = 0;                    // send the next frame even if the LEDs did not change
+  } else if (type == WS_EVT_DISCONNECT) {
+    for (unsigned i = 0; i < HG_WS_CLIENTS; i++) if (hgWsIds[i] == client->id()) hgWsIds[i] = 0;
+  }
+}
+
+// sends the LED colors to the preview clients, at most every HG_WS_FRAME_MS. Runs in loop() like the effects, so the
+// pixel buffer is consistent. Binary frame: 'H', version 1, bri, n0, n1, then n0 + n1 R,G,B samples evenly spread
+// over each strip's segment. White is added to RGB (like WLED's live view) and colors are not scaled by brightness:
+// the page maps brightness the way the gamma-corrected LEDs show it.
+void HomeGadgets::pushLive(uint32_t now) {
+  if (now - wsPushAt < HG_WS_FRAME_MS) return;
+  wsPushAt = now;
+  if (now - wsCleanAt >= HG_WS_KEEPALIVE_MS) {
+    wsCleanAt = now;
+    hgWs.cleanupClients(HG_WS_CLIENTS);
+  }
+  bool anyClient = false;
+  for (unsigned i = 0; i < HG_WS_CLIENTS; i++) if (hgWsIds[i]) anyClient = true;
+  if (!anyClient || ESP.getMaxAllocHeap() < HG_WS_MIN_HEAP) return;  // nobody watching, or low on memory: skip
+
+  size_t pos = 5;
+  wsFrame[0] = 'H';
+  wsFrame[1] = 1;
+  wsFrame[2] = bri;
+  for (unsigned k = 0; k < HG_STRIPS; k++) {
+    unsigned n = 0;
+    if (stripSeg[k] < strip.getSegmentsNum()) {
+      const Segment &seg = strip.getSegment(stripSeg[k]);
+      const unsigned len = seg.stop > seg.start ? seg.stop - seg.start : 0;
+      n = len < HG_WS_SAMPLES ? len : HG_WS_SAMPLES;
+      for (unsigned j = 0; j < n; j++) {
+        const uint32_t c = bri ? strip.getPixelColor(seg.start + (n > 1 ? j * (len - 1) / (n - 1) : 0)) : 0;
+        const uint8_t w = W(c);
+        wsFrame[pos++] = qadd8(w, R(c));
+        wsFrame[pos++] = qadd8(w, G(c));
+        wsFrame[pos++] = qadd8(w, B(c));
+      }
+    }
+    wsFrame[3 + k] = n;
+  }
+
+  // unchanged frames (a static look) are only repeated as a keepalive
+  uint32_t hash = 2166136261UL;
+  for (size_t i = 0; i < pos; i++) hash = (hash ^ wsFrame[i]) * 16777619UL;
+  if (hash == wsHash && now - wsSentAt < HG_WS_KEEPALIVE_MS) return;
+  bool sent = false;
+  for (unsigned i = 0; i < HG_WS_CLIENTS; i++) {
+    const uint32_t id = hgWsIds[i];
+    AsyncWebSocketClient *c = id ? hgWs.client(id) : nullptr;
+    if (!c || c->queueLength() > 0) continue;  // previous frame not sent yet: skip this one (like ws.cpp sendLiveLedsWs)
+    c->binary(wsFrame, pos);
+    sent = true;
+  }
+  if (sent) {
+    wsHash = hash;
+    wsSentAt = now;
+  }
+}
