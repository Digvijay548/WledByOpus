+// GET /home/bm: the look of each built-in mood (index = mood id), for the page's animated mood previews.
+// Streamed from the table, so the shared JSON buffer is not used (GET /home/cfg "bm" keeps names and gradients only).
+// pal "" = the effect's default palette. Static data without anything personal, so no key is needed.
+static void hgServeBuiltinLooks(AsyncWebServerRequest *request) {
+  AsyncResponseStream *res = request->beginResponseStream(FPSTR(CONTENT_TYPE_JSON));
+  res->addHeader(F("Cache-Control"), F("no-cache"));
+  res->print('[');
+  for (unsigned i = 0; i < HG_BUILTIN_COUNT; i++) {
+    const HgBuiltinMood &b = HG_BUILTIN_MOODS[i];
+    res->print(i ? F(",{\"pal\":\"") : F("{\"pal\":\""));
+    hgPrintJsonText(*res, b.pal);
+    res->printf("\",\"sx\":%u,\"ix\":%u,\"bri\":%u,\"col\":[%lu,%lu,%lu]}", b.sx, b.ix, b.bri,
+                (unsigned long)b.col[0], (unsigned long)b.col[1], (unsigned long)b.col[2]);
+  }
+  res->print(']');
+  request->send(res);
+}
